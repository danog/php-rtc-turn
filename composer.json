{
    "name": "danog/php-rtc-turn",
    "type": "library",
    "description": "A PHP implementation of TURN (Traversal Using Relays around NAT). Fork with FFI made optional and a pure-PHP DTLS/SRTP stack, maintained for MadelineProto.",
    "keywords": [
        "webrtc",
        "turn",
        "traversal-using-relays-around-nat"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "amphp/socket": "^2.3",
        "psr/log": "^3.0",
        "quasarstream/exception": "^1.0",
        "quasarstream/mixin": "^1.0",
        "quasarstream/stun": "^1.0"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "11.0.x-dev",
        "phpunit/phpunit": "^11.3",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\TURN\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\TURN\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "quasarstream/turn": "self.version"
    }
}
